          "type": "string"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Depends On",
          "type": "array"
        },
        "domain": {
          "const": "material",
          "default": "material",
          "title": "Domain",
          "type": "string"
        },
        "expected_source_fingerprints": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 128,
          "minProperties": 1,
          "title": "Expected Source Fingerprints",
          "type": "object"
        },
        "idempotency_key": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{7,199}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "material_instance_path": {
          "pattern": "^/(?:Game|Engine)/[A-Za-z0-9_./-]+$",
          "title": "Material Instance Path",
          "type": "string"
        },
        "minimal_change_rank": {
          "maximum": 3,
          "minimum": 0,
          "title": "Minimal Change Rank",
          "type": "integer"
        },
        "operation_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,119}$",
          "title": "Operation Id",
          "type": "string"
        },
        "operation_type": {
          "const": "bind_pbr_material",
          "default": "bind_pbr_material",
          "title": "Operation Type",
          "type": "string"
        },
        "slot_index": {
          "maximum": 255,
          "minimum": 0,
          "title": "Slot Index",
          "type": "integer"
        },
        "target_actor_id": {
          "maxLength": 160,
          "minLength": 3,
          "title": "Target Actor Id",
          "type": "string"
        },
        "texture_set_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Texture Set Receipt Sha256",
          "type": "string"
        },
        "uncertainty": {
          "maximum": 1,
          "minimum": 0,
          "title": "Uncertainty",
          "type": "number"
        },
        "uncertainty_reason": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Uncertainty Reason",
          "type": "string"
        },
        "validators": {
          "items": {
            "$ref": "#/$defs/OperationValidator"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Validators",
          "type": "array"
        },
        "write_scope": {
          "$ref": "#/$defs/WriteScope"
        }
      },
      "required": [
        "operation_id",
        "expected_source_fingerprints",
        "write_scope",
        "idempotency_key",
        "budget",
        "validators",
        "uncertainty",
        "uncertainty_reason",
        "minimal_change_rank",
        "capability_preferences",
        "compensation",
        "target_actor_id",
        "material_instance_path",
        "texture_set_receipt_sha256",
        "slot_index"
