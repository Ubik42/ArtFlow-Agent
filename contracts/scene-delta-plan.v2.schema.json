{
  "$defs": {
    "BindPBRMaterial": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/OperationBudget"
        },
        "capability_preferences": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Capability Preferences",
          "type": "array"
        },
        "compensation": {
          "enum": [
            "restore_staged_properties",
            "delete_generated_actors",
            "delete_generated_assets"
          ],
