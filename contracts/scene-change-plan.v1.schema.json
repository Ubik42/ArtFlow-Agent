{
  "$defs": {
    "ApplyPCGLayout": {
      "additionalProperties": false,
      "properties": {
        "approved_graph_path": {
          "pattern": "^/Game/ArtFlow/PCG/[A-Za-z0-9_./-]+$",
          "title": "Approved Graph Path",
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/OperationBudget"
        },
        "cleanup": {
          "enum": [
            "restore_staged_properties",
            "delete_generated_actors"
          ],
          "title": "Cleanup",
          "type": "string"
        },
        "component_id": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,159}$",
          "title": "Component Id",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Depends On",
          "type": "array"
        },
        "expected_source_fingerprints": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 128,
          "minProperties": 1,
          "title": "Expected Source Fingerprints",
          "type": "object"
        },
        "graph_parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "maxProperties": 64,
          "minProperties": 1,
          "title": "Graph Parameters",
          "type": "object"
        },
        "idempotency_key": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{7,199}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,119}$",
          "title": "Operation Id",
          "type": "string"
        },
        "operation_type": {
          "const": "apply_pcg_layout",
          "default": "apply_pcg_layout",
          "title": "Operation Type",
          "type": "string"
        },
        "seed": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "validators": {
          "items": {
            "$ref": "#/$defs/OperationValidator"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Validators",
          "type": "array"
        },
        "write_scope": {
          "$ref": "#/$defs/WriteScope"
        }
      },
      "required": [
        "operation_id",
        "expected_source_fingerprints",
        "write_scope",
        "idempotency_key",
        "budget",
        "validators",
        "cleanup",
        "component_id",
        "approved_graph_path",
        "graph_parameters",
        "seed"
      ],
      "title": "ApplyPCGLayout",
      "type": "object"
    },
    "OperationBudget": {
      "additionalProperties": false,
      "properties": {
        "max_actor_mutations": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Max Actor Mutations",
          "type": "integer"
        },
        "max_duration_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Duration Seconds",
          "type": "integer"
        },
        "max_spawned_actors": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Max Spawned Actors",
          "type": "integer"
        }
      },
      "required": [
        "max_actor_mutations",
        "max_spawned_actors",
        "max_duration_seconds"
      ],
      "title": "OperationBudget",
      "type": "object"
    },
    "OperationValidator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "protected_fingerprint",
            "bounds",
            "no_collision",
            "actor_budget",
            "pcg_graph_allowlist",
            "light_parameter_bounds",
            "zero_source_mutations"
          ],
          "title": "Kind",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "title": "OperationValidator",
      "type": "object"
    },
    "Rotator": {
      "additionalProperties": false,
      "properties": {
        "pitch": {
          "title": "Pitch",
          "type": "number"
        },
        "roll": {
          "title": "Roll",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "pitch",
        "yaw",
        "roll"
      ],
      "title": "Rotator",
      "type": "object"
    },
    "SetLightingRig": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/OperationBudget"
        },
        "cleanup": {
          "enum": [
            "restore_staged_properties",
            "delete_generated_actors"
          ],
          "title": "Cleanup",
          "type": "string"
        },
        "color_srgb": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Srgb"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Depends On",
          "type": "array"
        },
        "expected_source_fingerprints": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 128,
          "minProperties": 1,
          "title": "Expected Source Fingerprints",
          "type": "object"
        },
        "idempotency_key": {
          "pattern": "^[a-z0-9][a-z0-9._:-]{7,199}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "intensity": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intensity"
        },
        "operation_id": {
          "pattern": "^[a-z][a-z0-9._-]{2,119}$",
          "title": "Operation Id",
          "type": "string"
        },
        "operation_type": {
          "const": "set_lighting_rig",
          "default": "set_lighting_rig",
          "title": "Operation Type",
          "type": "string"
        },
        "rotation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rotator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_light_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Target Light Ids",
          "type": "array"
        },
        "temperature_kelvin": {
          "anyOf": [
            {
              "maximum": 20000,
              "minimum": 1000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature Kelvin"
        },
        "validators": {
          "items": {
            "$ref": "#/$defs/OperationValidator"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Validators",
          "type": "array"
        },
        "write_scope": {
          "$ref": "#/$defs/WriteScope"
        }
      },
      "required": [
        "operation_id",
        "expected_source_fingerprints",
        "write_scope",
        "idempotency_key",
        "budget",
        "validators",
        "cleanup",
        "target_light_ids"
      ],
      "title": "SetLightingRig",
      "type": "object"
    },
    "WriteScope": {
      "additionalProperties": false,
      "properties": {
        "asset_root": {
          "pattern": "^/Game/ArtFlow/Generated/[a-z0-9][a-z0-9._-]{2,119}$",
          "title": "Asset Root",
          "type": "string"
        },
        "stage_id": {
          "pattern": "^artflow-[a-z0-9][a-z0-9._-]{2,119}$",
          "title": "Stage Id",
          "type": "string"
        },
        "target_actor_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Target Actor Ids",
          "type": "array"
        }
      },
      "required": [
        "stage_id",
        "asset_root",
        "target_actor_ids"
      ],
      "title": "WriteScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "operations": {
      "items": {
        "discriminator": {
          "mapping": {
            "apply_pcg_layout": "#/$defs/ApplyPCGLayout",
            "set_lighting_rig": "#/$defs/SetLightingRig"
          },
          "propertyName": "operation_type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/SetLightingRig"
          },
          {
            "$ref": "#/$defs/ApplyPCGLayout"
          }
        ]
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "plan_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$",
      "title": "Plan Id",
      "type": "string"
    },
    "schema_id": {
      "const": "scene-change-plan/1",
      "default": "scene-change-plan/1",
      "title": "Schema Id",
      "type": "string"
    },
    "twin_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$",
      "title": "Twin Id",
      "type": "string"
    },
    "twin_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Twin Sha256",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "twin_id",
    "twin_sha256",
    "created_at",
    "operations"
  ],
  "title": "SceneChangePlan",
  "type": "object"
}
