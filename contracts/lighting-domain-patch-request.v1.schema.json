{
  "additionalProperties": false,
  "properties": {
    "candidate_scene_path": {
      "pattern": "^/Game/ArtFlow/Staging/[A-Za-z0-9_.-]+$",
      "title": "Candidate Scene Path",
      "type": "string"
    },
    "correction_plan_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correction Plan Sha256"
    },
    "expected_instance_count": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Expected Instance Count",
      "type": "integer"
    },
    "expected_material_path": {
      "pattern": "^/Game/ArtFlow/[A-Za-z0-9_./-]+$",
      "title": "Expected Material Path",
      "type": "string"
    },
    "intensity": {
      "maximum": 1000000,
      "minimum": 0,
      "title": "Intensity",
      "type": "number"
    },
    "parent_unreal_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Parent Unreal Receipt Sha256",
      "type": "string"
    },
    "protected_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protected State Sha256",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "failure_fixture",
        "domain_correction"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "request_id": {
      "pattern": "^m9-light-[0-9a-f]{20}$",
      "title": "Request Id",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "schema_id": {
      "const": "lighting-domain-patch-request/1",
      "default": "lighting-domain-patch-request/1",
      "title": "Schema Id",
      "type": "string"
    },
    "source_scene_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Scene Sha256",
      "type": "string"
    },
    "temperature_kelvin": {
      "maximum": 20000,
      "minimum": 1000,
      "title": "Temperature Kelvin",
      "type": "number"
    }
  },
  "required": [
    "request_id",
    "purpose",
    "candidate_scene_path",
    "source_scene_sha256",
    "protected_state_sha256",
    "parent_unreal_receipt_sha256",
    "intensity",
    "temperature_kelvin",
    "expected_instance_count",
    "expected_material_path",
    "request_sha256"
  ],
  "title": "LightingPatchRequest",
  "type": "object"
}
